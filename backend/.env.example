# ============================================================================
# CONFIGURARE CLOUD - SUPABASE (serverul online). Copiați în backend/.env (NU se comite).
# Toate valorile de mai jos sunt PLACEHOLDER-e / goale; secretele reale se pun doar în backend/.env sau în mediul serverului.
# ============================================================================
CIMITIR_MODE=online
CIMITIR_DB_ENGINE=postgres
CIMITIR_STORAGE_DRIVER=supabase

# PostgreSQL (Supabase pooler, sslmode=require)
DATABASE_URL=

# Supabase Storage PRIVAT (cheie secretă DOAR pe server)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=cimitir-private
