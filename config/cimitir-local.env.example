# MOD LOCAL: desktop (MAIN) + portal pe ACELASI calculator si pe ACEEASI baza SQLite.
# Nu se foloseste sincronizare: portalul citeste direct <CIMITIR_DATA_DIR>/cimitir.db.
# Utilizare (fara a atinge .env existent):
#   copiaza acest fisier ca C:\Cimitir\local.env, apoi:  set CIMITIR_ENV_FILE=C:\Cimitir\local.env
CIMITIR_DATA_DIR=C:\Cimitir\data
CIMITIR_HOST=127.0.0.1
CIMITIR_PORT=8000
CIMITIR_MODE=local
CIMITIR_PORTAL_REQUIRE_ACCOUNT=1
# Motor de date: sqlite (implicit, nu necesita nimic) sau postgres (vezi config/cimitir-online-postgres.env.example).
# PostgreSQL se activeaza DOAR cu CIMITIR_DB_ENGINE=postgres; DATABASE_URL singur nu activeaza nimic.
CIMITIR_DB_ENGINE=sqlite
DATABASE_URL=
