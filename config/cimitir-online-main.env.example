# MOD ONLINE - calculatorul MAIN (desktop). MAIN isi pastreaza baza SQLITE LOCALA si vorbeste cu serverul prin HTTPS.
# Adresa serverului si cheia se seteaza in MAIN: meniul "Sincronizare cloud" sau:
#   python scripts/configure_main_sync.py --data-dir C:\Cimitir\data --url https://cimitir.exemplu.ro --key cimitir.<secret> --auto
# NU seta CIMITIR_MODE=online pe MAIN (acel mod este doar pentru server).
CIMITIR_DATA_DIR=C:\Cimitir\data
# Certificat propriu / CA intern al serverului (daca nu e emis de un CA public):
# REQUESTS_CA_BUNDLE=C:\Cimitir\ca-server.pem
