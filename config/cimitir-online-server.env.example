# MOD ONLINE - SERVERUL public (portal cetateni + administrare web + API /api/sync/*).
# Se ruleaza in spatele unui proxy HTTPS (nginx/Caddy) sau direct cu certificat (uvicorn --ssl-keyfile/--ssl-certfile).
# Utilizare:  copiaza ca /etc/cimitir/server.env, apoi:  export CIMITIR_ENV_FILE=/etc/cimitir/server.env
CIMITIR_DATA_DIR=/var/lib/cimitir
CIMITIR_HOST=127.0.0.1
CIMITIR_PORT=8000
CIMITIR_MODE=online
CIMITIR_PORTAL_REQUIRE_ACCOUNT=1
# JWT_SECRET: optional; daca lipseste se genereaza automat in <CIMITIR_DATA_DIR>/.jwt_secret.
# Pentru valoare proprie genereaza una (NU copia un exemplu): python -c "import secrets; print(secrets.token_hex(32))"
# Prima cheie de sincronizare (se afiseaza o singura data):
#   python scripts/issue_sync_key.py --source cimitir
# In spatele unui proxy HTTPS (nginx/Caddy), porneste uvicorn cu: --proxy-headers --forwarded-allow-ips <ip-proxy>
# (limitarile pe IP folosesc adresa vazuta de uvicorn); expus direct: --no-proxy-headers
# E-mail real (resetare parola cetateni, alerte MAIN offline). Fara aceste valori furnizorul ramane "mock" (nu trimite).
# SMTP_HOST=smtp.furnizor.ro
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USER=cont@furnizor.ro
# SMTP_FROM=Cimitir <cont@furnizor.ro>
# SMTP_PASSWORD se seteaza din consola (Read-Host), nu se pastreaza intr-un fisier din repo.
# Adresa publica pentru linkurile din e-mail (sau din /admin/setari):
# CIMITIR_PUBLIC_URL=https://portal.exemplu.ro
# Copii de rezerva: CIMITIR_BACKUP_DIR=D:\Backup\Cimitir-server
# Motor de date: sqlite (implicit, nu necesita nimic) sau postgres (vezi config/cimitir-online-postgres.env.example).
# PostgreSQL se activeaza DOAR cu CIMITIR_DB_ENGINE=postgres; DATABASE_URL singur nu activeaza nimic.
CIMITIR_DB_ENGINE=sqlite
DATABASE_URL=
