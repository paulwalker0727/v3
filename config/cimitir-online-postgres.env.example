# SERVER ONLINE cu PostgreSQL (Etapa 1). Copiază în backend/.env (sau setează variabilele în mediul procesului).
# NU pune parola în cod și NU comite fișierul .env real.
CIMITIR_MODE=online
CIMITIR_DB_ENGINE=postgres
# Connection string furnizat de PostgreSQL gestionat (ex. Supabase: Project Settings -> Database -> Connection string).
# Pentru servicii externe adaugă ?sslmode=require. Format: postgresql://<utilizator>:<parola>@<host>:5432/<baza>
DATABASE_URL=
# Opționale
CIMITIR_PG_POOL_MAX=20
CIMITIR_PG_POOL_MIN=1
CIMITIR_PG_CONNECT_TIMEOUT=10
CIMITIR_PG_RETRY_SECONDS=3
# Rămân ca până acum
JWT_SECRET=
CIMITIR_PUBLIC_URL=
