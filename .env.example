# Cimitir cloud (Field Inbox + Phone Pairing + Phone Capture) — copiază în .env (NU se comite) sau setează în mediul procesului.
# Toate valorile de mai jos sunt PLACEHOLDER-e. Valorile reale există doar în environment-ul serverului.

# --- PostgreSQL (Supabase) — plan de control, rolul aplicației `cimitir_cp_app` (fără BYPASSRLS) ---
# Pooler Supabase, utilizator `cimitir_cp_app.<project_ref>`, sslmode=require.
CIMITIR_CP_DATABASE_URL=postgresql://cimitir_cp_app.<project_ref>:<PAROLA>@<host-pooler>:5432/postgres?sslmode=require
# Opțional: schema planului de control (implicit: public)
# CIMITIR_CP_SCHEMA=

# --- Supabase Storage PRIVAT (cheie secretă DOAR pe server) ---
SUPABASE_URL=https://<project_ref>.supabase.co
SUPABASE_SECRET_KEY=<sb_secret_...>
SUPABASE_BUCKET=<bucket-privat>
# Opțional: prefix în bucket
# SUPABASE_PREFIX=

# --- Proiectul acceptat de serverul public (20 litere); trebuie să coincidă cu SUPABASE_URL și cu URL-ul DB ---
CIMITIR_CLOUD_PROJECT_REF=<project_ref>

# --- Adresa publică HTTPS (nu e secret). Folosită de pagina /phone; HSTS se setează la proxy ---
CIMITIR_PUBLIC_URL=https://<domeniu-public>

# --- CORS: origini EXPLICITE care pot apela API-ul din browser (ex. portalul MAIN /admin/teren). Pagina /phone e same-origin și nu are nevoie. ---
# Listă separată prin virgulă, fără '*' (ignorat). Gol = CORS nemontat.
CIMITIR_FIELD_INBOX_CORS_ORIGINS=

# --- Proxy de încredere pentru X-Forwarded-For (IP/CIDR, fără /0). Gol = X-Forwarded-For ignorat ---
# În compose: subrețeaua rețelei interne a proxy-ului (ex. 172.28.0.0/24); pe host: 127.0.0.1
CIMITIR_PAIRING_TRUSTED_PROXIES=172.28.0.0/24

# --- Doar pentru deploy/cloud/docker-compose.example.yml (domeniul pentru Caddy/HTTPS) ---
CIMITIR_DOMAIN=<domeniu-public>

# --- Rulare ---
PORT=8080
CIMITIR_CLOUD_HOST=0.0.0.0
CIMITIR_LOG_LEVEL=INFO

# --- Pe calculatorul MAIN (NU pe server): URL-ul public al API-ului cloud, pentru Field Inbox / profilul Cloud ---
# CIMITIR_FIELD_INBOX_URL=https://<domeniu-public>

# --- NU se setează pe serverul cloud (nu sunt necesare serviciului): ---
# CIMITIR_CP_ADMIN_DATABASE_URL, CIMITIR_CP_CLEANUP_DATABASE_URL, DATABASE_URL, JWT_SECRET, SUPABASE_SERVICE_ROLE_KEY (vechi, doar dacă nu există SUPABASE_SECRET_KEY)

# Primul administrator Cloud (se generează cu scripts/generate_bootstrap_token.py --env-file .env; se scot după inițializare)
# BOOTSTRAP_TOKEN=
# BOOTSTRAP_TOKEN_EXPIRES_AT=
